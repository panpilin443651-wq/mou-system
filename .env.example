# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env จะไม่ถูก commit ขึ้น git)

# ------------------------------------------------------------------
# ฐานข้อมูล PostgreSQL ของ Supabase
# วิธีหา: supabase.com -> เลือกโปรเจกต์ -> ปุ่ม Connect (ด้านบน) -> แท็บ ORMs -> Prisma
#   DATABASE_URL = Transaction pooler (พอร์ต 6543) ต้องมี ?pgbouncer=true ต่อท้าย
#   DIRECT_URL   = Session pooler / Direct connection (พอร์ต 5432) ใช้ตอน prisma migrate
# [YOUR-PASSWORD] คือรหัสผ่านฐานข้อมูลที่ตั้งตอนสร้างโปรเจกต์
#   (ลืม: Project Settings -> Database -> Reset database password)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------
# ระบบ Login (Supabase Auth)
# วิธีหา: Project Settings -> API
#   NEXT_PUBLIC_SUPABASE_URL      = Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = anon public key
#   SUPABASE_SERVICE_ROLE_KEY     = service_role key (ความลับ! ห้ามเปิดเผย ห้ามใส่ NEXT_PUBLIC_ นำหน้า)
#                                   ใช้ให้ส่วนกลางสร้างบัญชีและตั้งรหัสผ่านให้ผู้อื่น
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------
# รหัสผ่านของบัญชี ADMIN คนแรก (ใช้ตอนรัน npm run db:seed)
# สร้างบัญชีใน Supabase Auth ให้เอง เปลี่ยนรหัสผ่านทันทีหลัง login ครั้งแรก
# ------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.ac.th"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ------------------------------------------------------------------
# โหมดจำลองสิทธิ์: หน้า login แสดงรายชื่อผู้ใช้ให้กดเข้าได้เลยโดยไม่ต้องใช้รหัสผ่าน
# ใช้ระหว่างทดลองระบบเท่านั้น เปิดไว้เมื่อไร ใครเปิดเว็บก็เข้าเป็นผู้ดูแลระบบได้
# ปิด = ไม่ใส่ค่า หรือใส่ค่าอื่นที่ไม่ใช่ "true"
# ------------------------------------------------------------------
DEMO_LOGIN=""


# ------------------------------------------------------------------
# ที่เก็บไฟล์แนบ (Vercel Blob)
# วิธีหา: vercel.com -> Storage -> Create Database -> Blob
#         -> เปิด store ที่สร้าง -> แท็บ Settings / .env.local -> คัดลอกค่า
# ค่าจะขึ้นต้นด้วย vercel_blob_rw_
# ------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
