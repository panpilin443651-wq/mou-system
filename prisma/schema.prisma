// ============================================================================
// โครงสร้างฐานข้อมูล - ระบบรายงานผลการดำเนินงานตาม MOU
// ============================================================================
// ไฟล์นี้คือ "พิมพ์เขียว" ของฐานข้อมูลทั้งหมด
// แก้ไฟล์นี้แล้วรัน `npm run db:migrate` เพื่อให้ฐานข้อมูลจริงเปลี่ยนตาม
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// ฐานข้อมูล PostgreSQL ของ Supabase
//   DATABASE_URL = ต่อผ่าน connection pooler (พอร์ต 6543 ต่อท้ายด้วย ?pgbouncer=true) ใช้ตอนเว็บทำงาน
//   DIRECT_URL   = ต่อตรง (พอร์ต 5432) ใช้ตอน prisma migrate เท่านั้น เพราะ pooler รันคำสั่งแก้โครงตารางไม่ได้
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ค่าคงที่ (Enum) - ชุดตัวเลือกที่กำหนดไว้ตายตัว ใส่ค่าอื่นไม่ได้
// ============================================================================

enum Role {
  ADMIN // ส่วนกลาง - จัดการทุกอย่าง สร้างตัวชี้วัดให้ส่วนงาน
  DEPT_USER // ผู้รับผิดชอบส่วนงาน (ผู้รายงาน) - เห็นเฉพาะของตัวเอง กรอกแผน/ผลและบันทึกร่างได้ แต่กดส่งไม่ได้
  DEPT_HEAD // หัวหน้าส่วนงาน/หัวหน้าหน่วยงานที่ไม่สังกัดส่วนงาน - ทำได้เหมือนผู้รายงาน และเป็นผู้กดส่งแผน/ส่งผล
  //           รับแจ้งเตือน (กระดิ่ง) เมื่อส่วนกลางตีกลับแผนหรือผล
  EXECUTIVE // ผู้บริหาร - ดูได้ทุกส่วนงาน แต่แก้ไขอะไรไม่ได้
}

enum DepartmentType {
  DIVISION // ส่วนงาน (กอง / เขต / ฝ่าย / สำนัก / สถาบัน)
  INDEPENDENT_UNIT // หน่วยงานที่ไม่สังกัดส่วนงาน
}

/// ทิศทางของตัวชี้วัด - ใช้ตัดสินว่าค่ามากหรือน้อยคือดี
/// เช่น "ค่าใช้จ่ายบริหารต่อไร่" ยิ่งน้อยยิ่งดี (ระดับ 5 = 77 บาท, ระดับ 1 = 111 บาท)
/// ส่วน "จำนวนเกษตรกรที่ได้รับการพัฒนา" ยิ่งมากยิ่งดี
enum ScoreDirection {
  HIGHER_IS_BETTER // ค่ามาก = คะแนนสูง
  LOWER_IS_BETTER // ค่าน้อย = คะแนนสูง
}

enum IndicatorStatus {
  DRAFT // ส่วนกลางกำลังร่าง ส่วนงานยังไม่เห็น
  ACTIVE // ใช้งานจริง ส่วนงานเห็นและกรอกผลได้
  ARCHIVED // ยกเลิก/ไม่ใช้แล้ว แต่เก็บประวัติไว้
}

enum ReportStatus {
  DRAFT // บันทึกร่างไว้ ยังแก้ได้
  SUBMITTED // ส่งแล้ว (ไม่มีขั้นตอนอนุมัติ - ส่งแล้วถือว่าจบ)
}

/// สองส่วนของแบบฟอร์มแผนดำเนินงาน (เอกสารแนบ 4)
/// แบบฟอร์มแยกตารางเป็นสองส่วนที่มีคอลัมน์เหมือนกัน แต่คนละความหมาย
enum PlanSection {
  TARGET // ส่วนที่ 1 "เป้าหมายตัวชี้วัด" - ผลงานที่ต้องทำให้ได้ตามตัวชี้วัด
  STEP // ส่วนที่ 2 "ติดตามการดำเนินงานตามแผน" - ขั้นตอน/กิจกรรมที่ทำเพื่อให้ถึงเป้าหมาย
}

// ============================================================================
// ตารางข้อมูลพื้นฐาน
// ============================================================================

/// สายบังคับบัญชา เช่น "รองผวก. (ป.)" - ใช้จัดกลุ่มส่วนงานในหน้าภาพรวม
model CommandLine {
  id        String @id @default(cuid())
  name      String @unique
  /// ลำดับที่แสดงในหน้าภาพรวมและหน้าตั้งค่า
  sortOrder Int    @default(0)

  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// ส่วนงาน / หน่วยงานที่ไม่สังกัดส่วนงาน (30 หน่วย)
model Department {
  id   String         @id @default(cuid())
  code String         @unique // รหัสย่อ เช่น "กจร.1", "ฝกค."
  name String // ชื่อเต็มของส่วนงาน
  type DepartmentType @default(DIVISION)

  /// ลำดับการแสดงผลในรายการและ Dashboard
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// สายบังคับบัญชาที่สังกัด - ส่วนกลางเปลี่ยนได้ที่ ตั้งค่าระบบ > สายบังคับบัญชา
  /// null = ยังไม่ได้จัดเข้าสายใด
  commandLineId String?
  commandLine   CommandLine? @relation(fields: [commandLineId], references: [id], onDelete: SetNull)

  users      User[]
  indicators Indicator[]
  exceptions WindowException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// ผู้ใช้งานระบบ - ADMIN เป็นผู้สร้างบัญชีให้ (ไม่มีการสมัครเอง)
/// รหัสผ่านและการ login อยู่ที่ Supabase Auth ตารางนี้เก็บสิทธิ์และสังกัด
model User {
  id     String  @id @default(cuid())
  /// id ของบัญชีใน Supabase Auth (auth.users.id) - null = ยังไม่ได้ย้ายบัญชีไป Supabase
  authId String? @unique
  email  String  @unique
  name   String
  /// รหัสผ่าน bcrypt จากระบบ login เดิม ไม่ได้ใช้แล้ว
  /// เก็บไว้ให้ prisma/migrate-users-to-supabase.ts ย้ายรหัสเดิมไป Supabase ผู้ใช้จะได้ไม่ต้องตั้งรหัสใหม่
  passwordHash String?

  role Role @default(DEPT_USER)

  /// สังกัดส่วนงานไหน - ADMIN และ EXECUTIVE ไม่ต้องมีสังกัด (null)
  /// DEPT_USER ต้องมีเสมอ เพราะใช้กรองว่าเห็นข้อมูลของใครได้บ้าง
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  submittedReports  QuarterlyReport[] @relation("ReportSubmitter")
  uploadedFiles     Attachment[]
  auditLogs         AuditLog[]
  editedMouScores   MouScore[]
  uploadedPlanFiles PlanAttachment[]
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

/// ปีงบประมาณ เช่น 2569 (1 ต.ค. 2568 - 30 ก.ย. 2569)
model FiscalYear {
  id   Int @id @default(autoincrement())
  /// ปี พ.ศ. เช่น 2569
  year Int @unique

  startDate DateTime
  endDate   DateTime

  /// ปีที่ระบบกำลังใช้งานอยู่ - ควรมีแค่ปีเดียวที่เป็น true
  isActive Boolean @default(false)

  indicators Indicator[]
  windows    SubmissionWindow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// ตารางหลัก - ตัวชี้วัดและองค์ประกอบ
// ============================================================================

/// ตัวชี้วัด (KPI) - สร้างโดยส่วนกลางเท่านั้น ส่วนงานแก้ไขไม่ได้
model Indicator {
  id String @id @default(cuid())

  fiscalYearId Int
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  code        String // ลำดับตัวชี้วัดใน MOU เช่น "1", "2.1"
  name        String // ชื่อตัวชี้วัด เช่น "ค่าใช้จ่ายบริหารต่อไร่ (PA)"
  description String? // นิยาม / สูตรการคำนวณ / เงื่อนไข ตามที่ระบุใน MOU

  /// มิติที่ตัวชี้วัดสังกัด เช่น "มิติด้านการเงิน", "มิติด้านกระบวนการภายใน"
  /// MOU จัดกลุ่มตัวชี้วัดตามมิติ และรายงานสรุปก็แยกตามมิติเช่นกัน
  dimension String?

  /// หัวข้อกลุ่มของตัวชี้วัดย่อย เช่น ข้อ 4.1 และ 4.2 อยู่ใต้หัวข้อ
  /// "ความสามารถในการบริหารแผนลงทุน (PA)" - null ถ้าไม่ใช่ตัวชี้วัดย่อย
  groupName String?

  unit          String // หน่วยวัด เช่น "บาท/ไร่", "ร้อยละ", "ระดับ", "ล้านบาท"
  /// ค่าเป้าหมายหลักทั้งปี = ค่าเกณฑ์วัดระดับ 3 ตามรูปแบบ MOU ของ กยท.
  /// ใช้เป็นตัวหารในการคำนวณ % ความก้าวหน้า
  /// null = ค่าเป้าหมายไม่ใช่ตัวเลข (ดู targetText) ระบบจึงคิด % ความก้าวหน้าให้ไม่ได้
  targetValue   Float?
  /// ค่าเป้าหมายหลักแบบข้อความ ใช้เมื่อ MOU กำหนดเป้าหมายระดับ 3 เป็นคำบรรยาย ไม่ใช่ตัวเลข
  targetText    String?

  /// เงื่อนไขของตัวชี้วัด (ใช้กับทั้งตัวชี้วัด ไม่ได้แยกตามระดับ)
  /// เช่น "รายงานผลภายในวันที่ 15 ของเดือนถัดไป" มีได้หลายข้อ เรียงตามที่กรอก
  conditions String[] @default([])
  /// ผลการดำเนินงานปีก่อน (Base line 2568) - null ถ้า MOU ระบุเป็น "-"
  baselineValue Float?
  /// น้ำหนักของตัวชี้วัด (%) - ผลรวมทุกตัวชี้วัดของส่วนงานต้องเท่ากับ 100
  weight        Float  @default(0)

  /// ค่ามากดีหรือค่าน้อยดี - จำเป็นต่อการให้คะแนนและการคิด % ความก้าวหน้า
  /// เช่น "ค่าใช้จ่ายบริหารต่อไร่" ค่าน้อยยิ่งดี (ระดับ 5 = 77 บาท)
  direction ScoreDirection @default(HIGHER_IS_BETTER)

  /// ข้อความ "การปรับค่าเกณฑ์วัด" จาก MOU เช่น "-/+ 8.50" (เก็บไว้อ้างอิง)
  adjustmentNote String?

  /// ตารางให้คะแนนย่อยจาก MOU สำหรับตัวชี้วัดที่ไม่ได้เขียนเกณฑ์เป็นระดับ 1-5
  /// เช่น "จัดทำแบบระบุปัจจัยเสี่ยง — 2 คะแนน" หลายบรรทัดต่อกัน
  /// เก็บแยกจาก description เพราะเป็นเงื่อนไขการให้คะแนน ไม่ใช่คำจำกัดความ
  criteriaNote String?

  status IndicatorStatus @default(ACTIVE)

  criteria         ScoreCriteria[]
  plans            ActionPlan[]
  planHeader       PlanHeader?
  planLevelReports PlanLevelReport[]
  reports          QuarterlyReport[]
  mouScores        MouScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ห้ามมีรหัสตัวชี้วัดซ้ำกันภายในส่วนงานเดียวกันในปีงบเดียวกัน
  @@unique([fiscalYearId, departmentId, code])
  @@index([fiscalYearId, departmentId])
  @@index([status])
}

/// เกณฑ์คะแนน 1-5 ของแต่ละตัวชี้วัด ("ระดับค่าเป้าหมาย" ใน MOU)
///
/// MOU ของ กยท. กำหนดเกณฑ์เป็น "ค่าเป้าหมาย 1 ค่าต่อ 1 ระดับ" เช่น
///   ระดับ 1 = 111.00 บาทต่อไร่ | ระดับ 3 = 94.00 | ระดับ 5 = 77.00
/// จึงใช้ targetValue เป็นหลัก ส่วน minValue/maxValue มีไว้เผื่อตัวชี้วัด
/// ที่กำหนดเป็นช่วงค่าแทนค่าเดี่ยว
model ScoreCriteria {
  id String @id @default(cuid())

  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  /// ระดับคะแนน 1-5
  level       Int
  description String // คำอธิบายเกณฑ์ตามที่ระบุใน MOU

  /// ค่าเป้าหมายของระดับนี้ (รูปแบบหลักที่ MOU ใช้)
  /// null = เกณฑ์ระดับนี้เป็นข้อความ (อยู่ใน description) ไม่ใช่ตัวเลข
  targetValue Float?

  /// ช่วงค่าของเกณฑ์นี้ - ใช้เมื่อ MOU กำหนดเป็นช่วงแทนค่าเดี่ยว
  /// null = ไม่จำกัดด้านนั้น
  minValue Float?
  maxValue Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([indicatorId, level])
}

/// ส่วนหัวของแบบฟอร์มแผนดำเนินงาน (เอกสารแนบ 4) - 1 ตัวชี้วัดมีได้ 1 แถว
///
/// แยกออกจาก Indicator เพราะสองส่วนนี้เป็นของส่วนงาน ไม่ใช่ของส่วนกลาง
/// ส่วนงานแก้ผู้รับผิดชอบและงบประมาณของแผนตัวเองได้ แต่แก้ตัวชี้วัดไม่ได้
model PlanHeader {
  id String @id @default(cuid())

  indicatorId String    @unique
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  /// "ผู้รับผิดชอบตัวชี้วัด" เช่น "การยางแห่งประเทศไทยเขตภาคเหนือ/กองแผนและวิชาการ"
  owner  String?
  /// "งบประมาณ" เก็บเป็นข้อความเพราะแบบฟอร์มเขียนรวมหน่วยไว้ เช่น "71,000 บาท"
  budget String?

  /// ผู้รับผิดชอบส่วนงานกด "ยืนยันแผน" เมื่อไร - null = ยังไม่ยืนยัน (ยังแก้แผนได้ และยังรายงานผลไม่ได้)
  /// ยืนยันแล้ว แผนรายเดือน เป้าหมาย ค่าเป้าหมาย หน่วยนับ และขั้นตอนการดำเนินงาน จะล็อก
  /// ส่วนกลางปลดล็อกได้ (ตั้งกลับเป็น null)
  confirmedAt   DateTime?
  /// id ของผู้ใช้ที่กดยืนยัน (ไม่ผูก relation เพราะใช้แสดงผลอย่างเดียว)
  confirmedById String?

  /// ส่วนกลางตีกลับแผนเมื่อไร และเหตุผล - ตีกลับแล้ว confirmedAt เป็น null (แผนปลดล็อกให้แก้)
  /// ล้างทั้งสองช่องเมื่อหัวหน้าส่วนงานกดส่งแผนใหม่
  returnedAt DateTime?
  returnNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// หนึ่งบรรทัดในตารางแผนดำเนินงานตามแบบฟอร์มเอกสารแนบ 4
///
/// แบบฟอร์มจริงเป็นตารางรายเดือน 12 เดือน โดย 1 รายการกินกระดาษ 2 บรรทัด
/// บรรทัดบน = "แผน" บรรทัดล่าง = "ผล" ในฐานข้อมูลจึงเก็บเป็น 1 แถว
/// แล้วมีตัวเลขรายเดือนสองชุด ไม่ได้แยกเป็นสองแถวเหมือนที่เห็นบนกระดาษ
model ActionPlan {
  id String @id @default(cuid())

  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  /// อยู่ตารางบน (เป้าหมายตัวชี้วัด) หรือตารางล่าง (ขั้นตอนการดำเนินงาน)
  section   PlanSection @default(STEP)
  /// ลำดับที่แสดงในตาราง (คอลัมน์แรกของแบบฟอร์ม) นับแยกในแต่ละ section และแต่ละระดับ
  sortOrder Int         @default(0)

  /// ขั้นตอนการดำเนินงานนี้อยู่ใต้ค่าเกณฑ์ระดับไหน (1-5) - ใช้กับ section STEP
  /// null = TARGET หรือแถว STEP เก่าที่สร้างก่อนแยกตามระดับ
  criteriaLevel Int?

  /// ข้อความในคอลัมน์ "เป้าหมายตัวชี้วัด" หรือ "ขั้นตอนการดำเนินงาน" แล้วแต่ section
  title       String
  /// "ค่าเป้าหมาย" ของรายการนี้ - null ได้ เพราะบางรายการยังไม่กำหนด
  targetValue Float?
  /// "หน่วยนับ" เช่น "ไร่", "ครั้ง", "รายงาน", "ร้อยละ"
  unit        String?

  /// ตัวเลขรายเดือน 12 ช่อง เรียงตามปีงบประมาณ ต.ค. → ก.ย.
  /// รูปแบบ: (number | null)[] ยาว 12 · null = เว้นว่างไว้ (ไม่ใช่ศูนย์)
  /// เก็บเป็น Json เพราะเป็นตารางที่ผู้ใช้กรอกทั้งแถวพร้อมกัน
  /// ไม่เคยถูกค้นหาหรือรวมยอดที่ฝั่งฐานข้อมูล จึงไม่คุ้มที่จะแตกเป็น 12 คอลัมน์
  planMonths   Json
  actualMonths Json

  /// "สาเหตุที่ไม่สามารถดำเนินการได้ตามเป้าหมาย/ตามแผน"
  causeNote        String?
  /// "แนวทางการดำเนินการแก้ไข"
  correctiveAction String?
  /// หลักฐานแบบข้อความของเดิม - หน้าเว็บเปลี่ยนไปแนบไฟล์แทนแล้ว (ดู attachments)
  /// คงคอลัมน์ไว้ไม่ให้ข้อความที่เคยกรอกหาย
  evidence         String?
  /// "หลักฐานประกอบผลการดำเนินงาน" แบบแนบไฟล์
  attachments      PlanAttachment[]
  /// "คำอธิบายเพิ่มเติม (ถ้ามี)"
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([indicatorId, section, sortOrder])
}

/// "รายงานผลการดำเนินงาน" ของค่าเกณฑ์แต่ละระดับ ในตารางติดตามการดำเนินงานตามแผน
/// 1 ตัวชี้วัด มีได้ระดับละ 1 ข้อความ
model PlanLevelReport {
  id String @id @default(cuid())

  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  /// ค่าเกณฑ์ระดับ 1-5
  level Int
  text  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([indicatorId, level])
}

/// ไฟล์หลักฐานประกอบผลการดำเนินงาน ของบรรทัดหนึ่งในแผนดำเนินงาน
///
/// แยกจาก Attachment (ไฟล์แนบของรายงานรายไตรมาส) เพราะผูกกับคนละสิ่ง
/// แผนเป็นของทั้งปี ไม่มีไตรมาส และไม่อยู่ใต้ช่วงเวลาเปิด-ปิดรับผล
model PlanAttachment {
  id String @id @default(cuid())

  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  originalName String
  /// URL ของไฟล์บน Vercel Blob - ไม่ส่งให้เบราว์เซอร์เห็น ดาวน์โหลดผ่าน /api/plan-attachments/[id]
  storagePath  String
  mimeType     String
  sizeBytes    Int

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  @@index([actionPlanId])
}

// ============================================================================
// ตารางหลัก - การรายงานผลรายไตรมาส
// ============================================================================

/// ผลการดำเนินงานรายไตรมาส - ส่วนงานเป็นผู้กรอก
model QuarterlyReport {
  id String @id @default(cuid())

  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  /// ไตรมาส 1-4
  quarter Int

  /// ผลงานที่ทำได้จริง - ส่วนงานกรอกเอง (ระบบอ่านจากไฟล์แนบไม่ได้)
  actualValue Float?

  /// % ความก้าวหน้า = actualValue / targetValue * 100 (จำกัดไม่เกิน 100)
  /// คำนวณและบันทึกไว้ตอนกด save เพื่อให้ Dashboard ดึงไปสรุปได้เร็ว
  progressPct Float?

  /// คะแนน 1-5 ที่ได้จากการเทียบกับ ScoreCriteria
  scoreLevel Int?

  /// true = ผู้ประเมินปรับคะแนนด้วยมือ ไม่ใช่ค่าที่ระบบคำนวณ
  scoreOverridden Boolean @default(false)
  scoreNote       String? // เหตุผลที่ปรับคะแนน

  narrative String? // คำอธิบายผลการดำเนินงาน (สรุปสั้น)

  // --------------------------------------------------------------------------
  // ช่องตามแบบฟอร์มรายงานผลของ กยท. (เอกสารแนบ 3)
  // เรียงตามหัวข้อในแบบฟอร์ม เพื่อให้พิมพ์ออกมาแล้วตรงกับของเดิมที่เคยใช้
  // --------------------------------------------------------------------------
  /// 1. ผู้รับผิดชอบ
  responsible     String?
  /// 2. วัตถุประสงค์
  objective       String?
  /// 5.1 แผนงาน/โครงการ/การดำเนินงานสำคัญ ที่ช่วยปรับปรุงการดำเนินงานของตัวชี้วัดนี้
  keyProjects     String?
  /// 5.2.2 ปัญหาอุปสรรคและการแก้ไข
  problems        String?
  /// 5.3.1 ปัจจัยที่สนับสนุน
  supportFactors  String?
  /// 5.3.2 ปัจจัยที่เป็นปัญหา/อุปสรรค
  obstacleFactors String?

  status        ReportStatus @default(DRAFT)
  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?        @relation("ReportSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  /// ส่วนกลางตีกลับผลเมื่อไร และเหตุผล - ตีกลับแล้ว status กลับเป็น DRAFT
  /// ล้างทั้งสองช่องเมื่อหัวหน้าส่วนงานกดส่งผลใหม่
  returnedAt DateTime?
  returnNote String?

  attachments      Attachment[]
  /// 4. รายงานผลการดำเนินงาน แยกเป็นแต่ละค่าเกณฑ์
  criteriaProgress CriteriaProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 1 ตัวชี้วัด มีได้ 1 รายงานต่อ 1 ไตรมาสเท่านั้น
  @@unique([indicatorId, quarter])
  @@index([status])
}

/// รายงานผลการดำเนินงานตามแผนงาน/โครงการ/กิจกรรมดังกล่าว แยกตามค่าเกณฑ์แต่ละระดับ
///
/// ทำไมแยกตาราง ไม่เก็บเป็นช่องเดียวใน QuarterlyReport เหมือนหัวข้ออื่น?
///   MOU กำหนดเงื่อนไขไว้คนละอย่างในแต่ละระดับคะแนน ผลการดำเนินงานจึงต้องเขียน
///   แยกทีละระดับให้ตรงกับหลักฐานที่แนบไว้ในระดับเดียวกัน (ดู Attachment.criteriaLevel)
///   ถ้ารวมเป็นข้อความก้อนเดียว ผู้ตรวจจะแยกไม่ออกว่าย่อหน้าไหนคู่กับไฟล์ไหน
///
/// ระดับคะแนนของแต่ละตัวชี้วัดมีไม่เท่ากัน จึงไม่ใช้ช่องตายตัว 5 ช่อง
model CriteriaProgress {
  id String @id @default(cuid())

  reportId String
  report   QuarterlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// ระดับคะแนน 1-5 ที่ข้อความนี้อธิบายถึง (ตรงกับ ScoreCriteria.level)
  level Int

  /// ผลการดำเนินงานของระดับนี้
  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 1 รายงาน มีข้อความได้ระดับละ 1 ข้อความเท่านั้น
  @@unique([reportId, level])
  @@index([reportId])
}

/// ไฟล์แนบหลักฐานประกอบรายงาน
/// เก็บเฉพาะข้อมูลของไฟล์ ตัวไฟล์จริงอยู่บนดิสก์ตาม storagePath
model Attachment {
  id String @id @default(cuid())

  reportId String
  report   QuarterlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// ระดับคะแนน 1-5 ที่ไฟล์นี้เป็นหลักฐานให้
  /// MOU ของ กยท. กำหนดเงื่อนไขไว้แยกแต่ละระดับ หลักฐานจึงต้องแยกตามระดับด้วย
  /// null = หลักฐานทั่วไปที่ไม่ผูกกับระดับใดระดับหนึ่ง
  criteriaLevel Int?

  originalName String // ชื่อไฟล์เดิมที่ผู้ใช้อัปโหลด (ใช้ตอนดาวน์โหลด)
  /// URL ของไฟล์บน Vercel Blob (ไม่ได้เก็บไฟล์ไว้บนเซิร์ฟเวอร์เอง
  /// เพราะ Vercel ล้างไฟล์ที่เขียนลงดิสก์ทุกครั้งที่ deploy ใหม่)
  storagePath  String
  mimeType     String
  sizeBytes    Int

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  @@index([reportId])
  @@index([reportId, criteriaLevel])
}

// ============================================================================
// ตารางควบคุมการเปิด-ปิดระบบ
// ============================================================================

/// ช่วงเวลาที่เปิดให้ส่วนงานกรอกผลและแนบไฟล์ของแต่ละไตรมาส
/// เซิร์ฟเวอร์ต้องตรวจตารางนี้ทุกครั้งก่อนบันทึกหรือรับไฟล์
model SubmissionWindow {
  id String @id @default(cuid())

  fiscalYearId Int
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  quarter Int // 1-4

  /// เก็บเป็นเวลา UTC เสมอ แล้วค่อยแปลงเป็น Asia/Bangkok ตอนแสดงผล
  openAt  DateTime
  closeAt DateTime

  /// ปิดฉุกเฉินทันทีโดยไม่ต้องรอถึง closeAt
  isForceClosed Boolean @default(false)

  /// true = ส่วนกลางกำหนดวันเวลาเปิด-ปิดเอง ระบบใช้ openAt/closeAt ของแถวนี้
  /// false = ใช้ช่วง 3 เดือนของไตรมาส (fiscalQuarterRange) ตามเดิม ไม่สน openAt/closeAt ที่เก็บไว้
  isCustom Boolean @default(false)

  exceptions WindowException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fiscalYearId, quarter])
}

/// การขยายเวลาเฉพาะส่วนงาน (กรณีขอผ่อนผัน)
model WindowException {
  id String @id @default(cuid())

  windowId String
  window   SubmissionWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// เวลาปิดใหม่เฉพาะส่วนงานนี้ (ต้องช้ากว่า closeAt เดิม)
  closeAt DateTime
  reason  String

  createdAt DateTime @default(now())

  @@unique([windowId, departmentId])
}

// ============================================================================
// คะแนนประเมินรายตัวชี้วัด (ชุดของส่วนกลาง)
// ============================================================================

/// คะแนนที่ส่วนกลางประเมินให้ตัวชี้วัดหนึ่งข้อ ในไตรมาสหนึ่ง
///
/// คนละชุดกับ QuarterlyReport ซึ่งเป็นผลที่ส่วนงาน "กรอกเอง" เข้ามาในระบบ
/// ตารางนี้คือคะแนนที่ส่วนกลางตรวจแล้วให้ ซึ่งเดิมทำกันในไฟล์ Excel
/// (คะแนน MOU/*.xlsx) และย้ายเข้าระบบเพื่อให้แอดมินแก้ไขได้โดยไม่ต้องส่งไฟล์กันไปมา
///
/// ไม่เก็บ "คะแนนถ่วงน้ำหนักสะสม" ไว้ในตาราง เพราะคำนวณกลับได้เสมอจาก
/// (ผล x น้ำหนักของตัวชี้วัด / 100) - ตรวจกับไฟล์ต้นฉบับครบ 596 ค่าแล้วว่าตรงกัน
/// ถ้าเก็บไว้ด้วย พอแอดมินแก้ "ผล" แล้วลืมแก้ตัวเลขสะสม ข้อมูลจะขัดกันเอง
model MouScore {
  id String @id @default(cuid())

  indicatorId String
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  /// ไตรมาส 1-4
  quarter Int

  /// ค่าเป้าหมายตามแผนของไตรมาสนั้น (ระดับ 1-5)
  plan Float?

  /// ผลที่ทำได้จริง วัดเทียบกับแผนทั้งปี (ระดับ 1-5) - ใช้คิดคะแนนถ่วงน้ำหนักสะสม
  actual Float?

  /// คะแนนของไตรมาส วัดเทียบกับแผนของไตรมาสนั้น เต็ม 5
  /// ส่วนใหญ่เท่ากับ ผล x 5 / แผน แต่ส่วนกลางปรับด้วยมือได้ จึงเก็บแยกเป็นช่องของตัวเอง
  score Float?

  /// หมายเหตุของไตรมาสนั้น เช่น "เนื่องจากไม่รายงานผล"
  note String?

  /// ใครแก้ล่าสุด - ไว้ตามตัวได้เวลาตัวเลขมีปัญหา
  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 1 ตัวชี้วัด มีคะแนนได้ไตรมาสละ 1 ชุดเท่านั้น
  @@unique([indicatorId, quarter])
  @@index([indicatorId])
}

// ============================================================================
// การแจ้งเตือน (กระดิ่งบนแถบเมนู)
// ============================================================================

/// แจ้งเตือนถึงผู้ใช้หนึ่งคน เช่น "ส่วนกลางตีกลับแผน ข้อ 2.1"
/// ส่งถึงหัวหน้าส่วนงานทุกคนของส่วนงานนั้น (1 คน = 1 แถว แต่ละคนอ่านแล้วแยกกัน)
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  body  String?
  /// หน้าที่กดแล้วพาไป เช่น /plans/<id>
  link  String?

  /// null = ยังไม่อ่าน (กระดิ่งเป็นสีแดง)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ============================================================================
// ประวัติการใช้งาน
// ============================================================================

/// บันทึกว่าใครทำอะไรเมื่อไหร่ - ใช้ตรวจสอบย้อนหลัง
model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String // เช่น "INDICATOR_CREATE", "REPORT_SUBMIT", "FILE_UPLOAD"
  entity   String // ชื่อตาราง เช่น "Indicator"
  entityId String?
  detail   Json? // ข้อมูลเพิ่มเติม เช่น ค่าก่อน-หลังการแก้ไข

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
